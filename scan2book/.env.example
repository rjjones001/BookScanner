# Copy to .env and export before starting (or use docker compose --env-file)
DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_PAGES=300
RETENTION_DAYS=7
JOB_WORKERS=2
PAGE_WORKERS=2
LOW_CONF_THRESHOLD=0.60
TESS_LANG=eng
# Optional: AI suggestions for uncertain crops. Sends image crops to Anthropic. Leave empty to keep everything local.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
